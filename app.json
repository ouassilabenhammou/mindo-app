{
  "expo": {
    "name": "Mindo",
    "slug": "mindo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mindoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ouassila.mindo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.ouassila.mindo"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "700c26ee-3be6-4125-bd96-251c4116c480"
      }
    },
    "owner": "ouassila00"
  }
}

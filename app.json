{
  "expo": {
    "name": "Mindo",
    "slug": "mindo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mindoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ouassila.mindo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFCF5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.ouassila.mindo"
    }
  }
}
